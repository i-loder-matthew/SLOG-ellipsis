{##
Ellipsis with gapping constructions:

##}


S! -> r{{ cnt.next() }}(NP_animate_nsubj, V_trans_not_omissible, NP_dobj, AND, NP_animate_nsubj, NP_dobj)
[english] *(?1, *(?2, *(?3, *(?4, *(?5, ?6)))))
[semantics] junct2(junct1(?4, theme(agent(?2, ?1), ?3)), theme(agent(?2, ?5), ?6))


NP_dobj -> r{{ cnt.next() }}(NP_inanimate_dobj) [0]
[english] ?1
[semantics] ?1

NP_dobj -> r{{ cnt.next() }}(NP_animate_dobj) [1]
[english] ?1
[semantics] ?1



NP_animate_dobj -> r{{ cnt.next() }}(Det, N_common_animate_dobj) [0.5]
[english] *(?1, ?2)
[semantics] pre_det(?2, ?1)

NP_animate_dobj -> r{{ cnt.next() }}(N_prop_dobj) [0.5]
[english] ?1
[semantics] ?1




NP_animate_nsubj -> r{{ cnt.next() }}(Det, N_common_animate_nsubj) [0.5]
[english] *(?1, ?2)
[semantics] pre_det(?2, ?1)

NP_animate_nsubj -> r{{ cnt.next() }}(N_prop_nsubj) [0.5]
[english] ?1
[semantics] ?1

