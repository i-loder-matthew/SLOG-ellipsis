{##
VP Ellipsis:
Transitive and intransitive verbs
##}



S! -> r{{ cnt.next() }}(NP_animate_nsubj, VP_external, AND, SO, AUX_did, NP_animate_nsubj) [1]
[english] *(*(?1, ?2), *(?3, *(?4, *(?5, ?6))))
[semantics] junct2(junct1(?3, pre_agent(?2, ?1)), pre_agent(?2, ?6))

VP_external -> r{{ cnt.next() }}(V_unerg) [0.25]
[english] ?1
[semantics] ?1

VP_external -> r{{ cnt.next() }}(V_trans_omissible) [0.25]
[english] ?1
[semantics] ?1

VP_external -> r{{ cnt.next() }}(V_trans_omissible, NP_dobj) [0.25]
[english] *(?1, ?2)
[semantics] theme(?1, ?2)

VP_external -> r{{ cnt.next() }}(V_trans_not_omissible, NP_dobj) [0.25]
[english] *(?1, ?2)
[semantics] theme(?1, ?2)





NP_dobj -> r{{ cnt.next() }}(NP_inanimate_dobj) [0]
[english] ?1
[semantics] ?1

NP_dobj -> r{{ cnt.next() }}(NP_animate_dobj) [1]
[english] ?1
[semantics] ?1



NP_animate_dobj -> r{{ cnt.next() }}(Det, N_common_animate_dobj) [0.5]
[english] *(?1, ?2)
[semantics] pre_det(?2, ?1)

{##
NP_animate_dobj -> r{{ cnt.next() }}(Det, N_common_animate_dobj, PP_loc) [0.25]
[english] *(*(?1, ?2), ?3)
[semantics] nmod(pre_det(?2, ?1), ?3)
##}

NP_animate_dobj -> r{{ cnt.next() }}(N_prop_dobj) [0.5]
[english] ?1
[semantics] ?1




NP_animate_nsubj -> r{{ cnt.next() }}(Det, N_common_animate_nsubj) [0.5]
[english] *(?1, ?2)
[semantics] pre_det(?2, ?1)

NP_animate_nsubj -> r{{ cnt.next() }}(N_prop_nsubj) [0.5]
[english] ?1
[semantics] ?1